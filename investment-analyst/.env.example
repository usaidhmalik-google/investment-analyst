# Copy to .env for local development. Never commit real values.
# Vertex AI (uses Application Default Credentials: `gcloud auth application-default login`)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=fde-investment-analyst-sandbox-dev
# Gemini 3.x (e.g. gemini-3.5-flash) is served from the `global` endpoint; 2.5 models work there too.
GOOGLE_CLOUD_LOCATION=global
AGENT_ENGINE_LOCATION=us-central1

# Models (Tiered Gemini 3.x: 3.5-flash for routing, 3.8-flash for financial reasoning)
ANALYST_ROUTER_MODEL=gemini-3.5-flash
ANALYST_REASONING_MODEL=gemini-3.8-flash
ANALYST_JUDGE_MODEL=gemini-3.5-flash

# Optional secondary data provider. In Cloud Run use ALPHA_VANTAGE_SECRET (Secret Manager) instead.
# ALPHA_VANTAGE_API_KEY=
# ALPHA_VANTAGE_SECRET=projects/fde-investment-analyst-sandbox-dev/secrets/alpha-vantage-api-key/versions/latest
SEC_USER_AGENT="MALIK LLC Investment Analyst you@example.com"

# Use bundled deterministic fixtures instead of live market APIs (demos / CI)
ANALYST_OFFLINE_MODE=false

# Conversation sessions: memory (single instance) | database (SESSION_DB_URL) | vertex (AGENT_ENGINE_ID)
SESSION_BACKEND=memory
# SESSION_DB_URL=sqlite+aiosqlite:///./sessions.db
# AGENT_ENGINE_ID=

PERSISTENCE_BACKEND=memory
ENABLE_CLOUD_TRACE=false
REQUIRE_IAP=false
LOG_LEVEL=INFO
PROMPT_VERSION=v1
