  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_\\-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "momentum",
                  "value",
                  "swing",
                  "income"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          },
          "experiment_variant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Experiment Variant"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "fact_check": {
            "$ref": "#/components/schemas/FactCheckResult"
          },
          "tools_called": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "type": "array",
            "title": "Tools Called"
          },
          "latency": {
            "$ref": "#/components/schemas/Latency"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "blocked": {
            "type": "boolean",
            "title": "Blocked",
            "default": false
          },
          "block_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Block Reason"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "session_id",
          "response",
          "fact_check",
          "latency"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "quote",
              "history",
              "metrics",
              "news",
              "sec_filing",
              "sec_financials",
              "strategy"
            ],
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "source"
        ],
        "title": "Citation",
        "description": "A single citable source shown to the analyst next to the narrative."
      },
      "ConfigResponse": {
        "properties": {
          "strategies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strategies"
          },
          "models": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Models"
          },
          "offline_mode": {
            "type": "boolean",
            "title": "Offline Mode"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "strategies",
          "models",
          "offline_mode",
          "prompt_version"
        ],
        "title": "ConfigResponse"
      },
      "FactCheckResult": {
        "properties": {
          "verified": {
            "type": "boolean",
            "title": "Verified"
          },
          "checked_numbers": {
            "type": "integer",
            "title": "Checked Numbers"
          },
          "matched_numbers": {
            "type": "integer",
            "title": "Matched Numbers"
          },
          "unverified_numbers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unverified Numbers"
          },
          "accuracy": {
            "type": "number",
            "title": "Accuracy"
          }
        },
        "type": "object",
        "required": [
          "verified",
          "checked_numbers",
          "matched_numbers",
          "accuracy"
        ],
        "title": "FactCheckResult"
      },
      "FeedbackRequest": {
        "properties": {
          "report_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Report Id"
          },
          "rating": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "rating"
        ],
        "title": "FeedbackRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Latency": {
        "properties": {
          "time_to_first_thought_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time To First Thought Ms"
          },
          "time_to_first_token_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time To First Token Ms"
          },
          "total_ms": {
            "type": "number",
            "title": "Total Ms"
          }
        },
        "type": "object",
        "required": [
          "total_ms"
        ],
        "title": "Latency"
      },
      "ToolCall": {
        "properties": {
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "agent",
          "tool"
        ],
        "title": "ToolCall"
      },
      "Usage": {
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens",
            "default": 0
          }
        },
        "type": "object",
        "title": "Usage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
