# Rendered by the official nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only ${PORT}, ${BACKEND_URL}, ${BACKEND_HOST},
# ${BACKEND_SNI} and ${DNS_RESOLVER} are substituted (NGINX_ENVSUBST_FILTER);
# every other $variable is native nginx.

# Re-resolve the backend hostname at runtime (Cloud Run IPs are not static).
resolver ${DNS_RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

server {
    listen ${PORT} default_server;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    # text/event-stream is intentionally NOT gzipped (would buffer SSE).
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    set $backend "${BACKEND_URL}";
    set $backend_host "${BACKEND_HOST}";
    set $backend_sni "${BACKEND_SNI}";

    # Container liveness (does not depend on the backend).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "ok\n";
    }

    # ---- Reverse proxy to the FastAPI backend --------------------------------
    location /api/ {
        include /etc/nginx/snippets/backend-proxy.conf;
    }

    location = /healthz {
        include /etc/nginx/snippets/backend-proxy.conf;
    }

    # ---- Static SPA ----------------------------------------------------------
    # Vite emits content-hashed files under /assets/: cache forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        # History-API fallback for client-side routes.
        try_files $uri $uri/ /index.html;
    }
}
